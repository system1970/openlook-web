{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": true,
    "incremental": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "target": "ES2022",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": [
    "src/index.ts",
    "src/lib/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "app"
  ]
}
