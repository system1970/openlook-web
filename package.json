{
  "name": "openlook",
  "version": "0.1.4",
  "description": "Video-first visual UX testing MCP for coding agents",
  "type": "module",
  "bin": {
    "openlook": "./dist/src/index.js",
    "openlook-mcp": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "prepack": "bun run build:mcp",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "mcp": "node dist/src/index.js",
    "mcp:dev": "bun run src/index.ts"
  },
  "keywords": [
    "mcp",
    "visual-testing",
    "ux-testing",
    "playwright",
    "gemini",
    "coding-agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/three": "^0.184.1",
    "next": "^15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
