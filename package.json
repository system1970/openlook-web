{
  "name": "openlook",
  "version": "0.1.0",
  "description": "Visual unit testing framework for user experience - test UX like code",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "openlook": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "openlook": "bun run src/index.ts",
    "website:dev": "npm run dev --prefix website",
    "website:build": "npm run build --prefix website",
    "website:preview": "npm run preview --prefix website"
  },
  "keywords": [
    "visual-testing",
    "ux-testing",
    "unit-testing",
    "user-experience",
    "qa-automation",
    "gemini",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.0.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "playwright": "^1.51.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}